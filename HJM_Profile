<script>
/* ===================== STARFIELD ===================== */
const canvas = document.getElementById('stars');
const ctx = canvas.getContext('2d');
let stars = [];
function resizeCanvas(){
  canvas.width = window.innerWidth;
  canvas.height = document.body.scrollHeight || window.innerHeight;
}
function initStars(){
  resizeCanvas();
  const count = Math.floor((canvas.width*canvas.height)/9000);
  stars = Array.from({length:count}, ()=>({
    x:Math.random()*canvas.width,
    y:Math.random()*canvas.height,
    r:Math.random()*1.4+.3,
    o:Math.random()*.6+.2,
    tw:Math.random()*.02+.005,
    dir: Math.random()>0.5?1:-1
  }));
}
function drawStars(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle = '#fff';
  stars.forEach(s=>{
    s.o += s.tw*s.dir;
    if(s.o>0.9||s.o<0.15) s.dir*=-1;
    ctx.globalAlpha = s.o;
    ctx.beginPath();
    ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha = 1;
  requestAnimationFrame(drawStars);
}
window.addEventListener('resize', initStars);
initStars();
drawStars();
setTimeout(initStars, 400); // re-measure after content renders

/* ===================== STATE / NAV ===================== */
const screens = ['intro','ch1','ch2','ch3','final'];
let explorerName = '홍재민';

function showScreen(id){
  screens.forEach(s=>document.getElementById('screen-'+s).classList.remove('active'));
  document.getElementById('screen-'+id).classList.add('active');
  window.scrollTo({top:0, behavior:'instant' in window ? 'instant':'auto'});
  setTimeout(initStars, 300);
  updateHud(id);
}

const hud = document.getElementById('hud');
const hudBottom = document.getElementById('hud-bottom');
const hudChap = document.getElementById('hudChap');
const hudPips = document.getElementById('hudPips');

function updateHud(screenId){
  if(screenId==='intro' || screenId==='final'){
    hud.classList.remove('show'); hudBottom.classList.remove('show');
    return;
  }
  hud.classList.add('show'); hudBottom.classList.add('show');
  const chapNum = {ch1:'01', ch2:'02', ch3:'03'}[screenId];
  hudChap.textContent = 'CHAPTER '+chapNum+' / 03';
  let total = 3, activeIdx = 0;
  if(screenId==='ch1') activeIdx = ch1Quest;
  if(screenId==='ch2') activeIdx = ch2Done.filter(Boolean).length;
  if(screenId==='ch3') activeIdx = 3;
  hudPips.innerHTML = '';
  for(let i=0;i<total;i++){
    const p = document.createElement('div');
    p.className = 'pip' + (i<activeIdx?' done':'') + (i===activeIdx?' active':'');
    hudPips.appendChild(p);
  }
}

