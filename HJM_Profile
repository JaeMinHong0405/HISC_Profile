<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MY UNIVERSE</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap" rel="stylesheet">
<style>
:root{
  --deep:#0A1650;
  --deep2:#050B2E;
  --panel:rgba(24,44,112,0.72);
  --purple:#8B5CF6;
  --pink:#FF5DA2;
  --cyan:#4FD8EE;
  --gold:#FFD93D;
  --green:#4ADE80;
  --coral:#FF7A45;
  --text:#FFFFFF;
  --dim:#C3CCF2;
  --border:rgba(255,255,255,0.2);
}
*{box-sizing:border-box; margin:0; padding:0;}
html,body{height:100%;}
body{
  background:
    radial-gradient(ellipse 900px 700px at 18% 0%, rgba(139,92,246,.38), transparent 60%),
    radial-gradient(ellipse 800px 600px at 92% 8%, rgba(79,216,238,.28), transparent 60%),
    radial-gradient(ellipse 1000px 800px at 50% 100%, rgba(255,93,162,.2), transparent 60%),
    linear-gradient(180deg, var(--deep) 0%, var(--deep2) 100%);
  color:var(--text);
  font-family:'Noto Sans KR','Space Grotesk',sans-serif;
  overflow-x:hidden;
  position:relative;
  min-height:100vh;
}
.disp{font-family:'Baloo 2','Space Grotesk',sans-serif;}
button{font-family:inherit; cursor:pointer;}

/* ===== STARFIELD ===== */
#stars, #stars2, #stars3{position:fixed; inset:0; z-index:0; pointer-events:none;}
.nebula{
  position:fixed; inset:0; z-index:0; pointer-events:none;
  background:
    radial-gradient(650px 450px at 12% 12%, rgba(139,92,246,.28), transparent 60%),
    radial-gradient(550px 420px at 88% 22%, rgba(255,93,162,.2), transparent 60%),
    radial-gradient(750px 550px at 50% 92%, rgba(79,216,238,.16), transparent 60%);
}
.sparkle{
  position:fixed; z-index:1; pointer-events:none; color:var(--gold);
  font-size:14px; opacity:.85; text-shadow:0 0 8px rgba(255,217,61,.8);
  animation:sparkleFloat 4s ease-in-out infinite, sparkleTwinkle 1.8s ease-in-out infinite;
}
@keyframes sparkleFloat{0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);}}
@keyframes sparkleTwinkle{0%,100%{opacity:.3;} 50%{opacity:1;}}

/* ===== HUD ===== */
#hud{
  position:fixed; top:0; left:0; right:0; z-index:50;
  display:flex; justify-content:space-between; align-items:center;
  padding:18px 26px;
  font-family:'Baloo 2',sans-serif;
  font-size:12px; letter-spacing:.08em; font-weight:600;
  color:var(--dim);
  pointer-events:none;
  opacity:0; transition:opacity .5s ease;
}
#hud.show{opacity:1;}
#hud .brand{color:var(--gold); font-weight:700; text-shadow:0 0 10px rgba(255,217,61,.6);}
#hud .chap-tag{
  background:var(--panel);
  border:2px solid var(--border);
  padding:6px 16px;
  border-radius:20px;
  backdrop-filter:blur(6px);
}
#hud-bottom{
  position:fixed; bottom:22px; left:0; right:0; z-index:50;
  display:flex; justify-content:center;
  opacity:0; transition:opacity .5s ease;
  pointer-events:none;
}
#hud-bottom.show{opacity:1;}
#hud-bottom .quest-pips{
  display:flex; gap:8px;
  background:var(--panel);
  border:2px solid var(--border);
  padding:9px 16px;
  border-radius:20px;
  backdrop-filter:blur(6px);
}
.pip{width:8px; height:8px; border-radius:50%; background:rgba(255,255,255,.25); transition:all .3s ease;}
.pip.active{background:var(--gold); box-shadow:0 0 10px var(--gold); width:20px; border-radius:5px;}
.pip.done{background:var(--green); box-shadow:0 0 6px var(--green);}

/* ===== SCREENS ===== */
.screen{
  position:relative; z-index:5;
  min-height:100vh;
  display:none;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:110px 22px 90px;
  text-align:center;
}
.screen.active{display:flex;}
.fade-in{animation:fadeUp .8s cubic-bezier(.16,1,.3,1) both;}
@keyframes fadeUp{from{opacity:0; transform:translateY(22px);} to{opacity:1; transform:translateY(0);}}

/* ===== PLANET RING (signature Mario-Galaxy touch) ===== */
.ringed{position:relative;}
.ringed::after{
  content:"";
  position:absolute; left:50%; top:50%;
  width:168%; height:44%;
  border:3px solid rgba(255,255,255,.35);
  border-radius:50%;
  transform:translate(-50%,-50%) rotate(-16deg);
  box-shadow:0 0 14px rgba(255,255,255,.15);
  pointer-events:none;
}

/* ===== INTRO ===== */
#screen-intro .planet-hero{
  width:120px; height:120px; border-radius:50%;
  background:radial-gradient(circle at 35% 30%, #E4D4FF, var(--purple) 55%, #3B2A8F 100%);
  box-shadow:0 0 70px rgba(139,92,246,.6), inset -14px -14px 26px rgba(0,0,0,.35);
  margin:0 auto 38px;
  animation:floatY 5s ease-in-out infinite, fadeUp .9s ease both;
}
@keyframes floatY{0%,100%{transform:translateY(0);} 50%{transform:translateY(-14px);}}
.kicker{
  font-family:'Baloo 2',sans-serif; font-weight:600; font-size:13px; letter-spacing:.3em;
  color:var(--cyan); margin-bottom:14px; opacity:0; animation:fadeUp .7s .1s ease both;
}
h1.title-main{
  font-family:'Baloo 2',sans-serif; font-weight:800;
  font-size:clamp(40px,8vw,70px);
  letter-spacing:.02em;
  background:linear-gradient(90deg,#fff,var(--cyan) 45%,var(--pink));
  -webkit-background-clip:text; background-clip:text; color:transparent;
  filter:drop-shadow(0 4px 18px rgba(139,92,246,.5));
  opacity:0; animation:fadeUp .8s .2s ease both;
}
.subtitle{
  color:var(--dim); font-size:16px; margin-top:12px; letter-spacing:.02em;
  opacity:0; animation:fadeUp .8s .32s ease both;
}
.explorer-input{
  margin-top:26px;
  opacity:0; animation:fadeUp .8s .4s ease both;
}
.explorer-input input{
  background:rgba(255,255,255,.06); border:2px solid var(--purple); border-radius:14px;
  color:var(--text); font-family:'Baloo 2',sans-serif; font-size:16px; text-align:center;
  padding:10px 14px; width:230px; letter-spacing:.03em;
}
.explorer-input input::placeholder{color:var(--dim); opacity:.6;}
.explorer-input input:focus{outline:none; border-color:var(--cyan);}
.explorer-input label{display:block; font-size:11.5px; color:var(--dim); letter-spacing:.18em; margin-bottom:9px; font-family:'Baloo 2',sans-serif; font-weight:600;}

.cta{
  margin-top:38px;
  font-family:'Baloo 2',sans-serif;
  font-weight:700; font-size:14px; letter-spacing:.06em;
  color:var(--deep);
  background:linear-gradient(90deg,var(--gold),var(--coral));
  border:3px solid rgba(255,255,255,.5);
  border-bottom:6px solid rgba(0,0,0,.28);
  padding:15px 32px; border-radius:44px;
  box-shadow:0 8px 26px rgba(255,122,69,.4);
  transition:transform .18s ease, box-shadow .18s ease, border-bottom-width .18s ease;
  opacity:0; animation:fadeUp .8s .5s ease both;
}
.cta:hover{transform:translateY(-3px) scale(1.03); box-shadow:0 12px 32px rgba(255,122,69,.55);}
.cta:active{transform:translateY(2px); border-bottom-width:2px;}
.cta:disabled{opacity:.35; cursor:not-allowed; transform:none; box-shadow:none;}
.cta.ghost{
  background:rgba(255,255,255,.06); color:var(--text);
  border:2px solid var(--border); border-bottom:2px solid var(--border);
  box-shadow:none;
}
.cta.ghost:hover{border-color:var(--cyan); color:var(--cyan);}

/* ===== CHAPTER HEADERS ===== */
.chap-head{max-width:640px; margin-bottom:44px;}
.chap-eyebrow{
  font-family:'Baloo 2',sans-serif; font-weight:700; font-size:13px; letter-spacing:.28em; color:var(--gold);
  text-shadow:0 0 10px rgba(255,217,61,.5);
}
.chap-title{
  font-family:'Baloo 2',sans-serif; font-weight:800; font-size:clamp(28px,5vw,42px);
  margin:10px 0 16px;
  text-shadow:0 3px 0 rgba(0,0,0,.25);
}
.chap-intro{color:var(--dim); font-size:15px; max-width:480px; margin:0 auto;}

/* ===== QUEST GRID (Chapter 1) ===== */
.quest-stage{width:100%; max-width:760px;}
.q-block{display:none; flex-direction:column; align-items:center;}
.q-block.active{display:flex;}

/* Quest 1: personality */
.star-orb{
  width:104px; height:104px; border-radius:50%; position:relative; cursor:pointer;
  background:radial-gradient(circle at 35% 30%, #FFF7D6, var(--gold) 60%, #C97E0E 100%);
  box-shadow:0 0 55px rgba(255,217,61,.55);
  margin:10px auto 30px;
  animation:pulseGlow 2.4s ease-in-out infinite;
  transition:transform .3s ease;
}
.star-orb:hover{transform:scale(1.1) rotate(6deg);}
@keyframes pulseGlow{0%,100%{box-shadow:0 0 42px rgba(255,217,61,.4);} 50%{box-shadow:0 0 68px rgba(255,217,61,.75);}}
.meter-wrap{width:100%; max-width:420px; margin:26px auto 8px; opacity:0;}
.meter-wrap.show{opacity:1; animation:fadeUp .6s ease both;}
.meter-labels{display:flex; justify-content:space-between; font-family:'Baloo 2',sans-serif; font-weight:600; font-size:13px; margin-bottom:8px;}
.meter-labels .from{color:var(--dim);}
.meter-labels .to{color:var(--cyan); font-weight:700;}
.meter-track{height:8px; border-radius:8px; background:rgba(255,255,255,.12); position:relative; overflow:visible;}
.meter-fill{height:100%; width:0%; background:linear-gradient(90deg,var(--purple),var(--cyan)); border-radius:8px; transition:width 1.4s cubic-bezier(.16,1,.3,1);}
.meter-fill.go{width:72%;}
.meter-dot{position:absolute; top:50%; left:0%; width:20px; height:20px; margin-top:-10px; margin-left:-10px; border-radius:50%; background:radial-gradient(circle at 35% 30%,#fff,var(--gold) 70%); box-shadow:0 0 14px var(--gold); transition:left 1.4s cubic-bezier(.16,1,.3,1);}
.meter-dot.go{left:72%;}
.reveal-line{margin-top:22px; font-size:15.5px; color:var(--text); max-width:440px; min-height:24px;}
.reveal-line .hl{color:var(--cyan); font-weight:700;}
.q-caption{font-size:13px; color:var(--dim); margin-top:6px; font-style:italic;}

/* Quest 2: off-duty planets */
.orbit-field{display:flex; gap:36px; flex-wrap:wrap; justify-content:center; margin:20px 0 10px;}
.mini-planet{
  width:96px; text-align:center; cursor:pointer;
}
.mp-ball{
  width:80px; height:80px; border-radius:50%; margin:0 auto 10px;
  display:flex; align-items:center; justify-content:center; font-size:28px;
  transition:transform .3s cubic-bezier(.34,1.56,.64,1), box-shadow .3s ease;
  position:relative;
}
.mini-planet:hover .mp-ball{transform:translateY(-8px) scale(1.1) rotate(-4deg);}
.mp-ball.p1{background:radial-gradient(circle at 35% 30%, #ffb3b6, #E5484D 65%, #7A1F22); box-shadow:0 0 32px rgba(229,72,77,.45);}
.mp-ball.p2{background:radial-gradient(circle at 35% 30%, #baf5ea, var(--cyan) 65%, #0C6E63); box-shadow:0 0 32px rgba(79,216,238,.4);}
.mp-ball.p3{background:radial-gradient(circle at 35% 30%, #ffc2e8, var(--pink) 65%, #8C1E76); box-shadow:0 0 32px rgba(255,93,162,.4);}
.mp-name{font-family:'Baloo 2',sans-serif; font-weight:600; font-size:12px; letter-spacing:.08em; color:var(--dim);}
.mp-caption{
  font-size:13.5px; color:var(--text); max-width:210px; margin:8px auto 0; min-height:38px; opacity:0; transition:opacity .4s ease;
}
.mp-caption.show{opacity:1;}
.mini-planet.done .mp-ball{outline:3px solid var(--gold); outline-offset:4px;}

/* Quest 3: summary */
.summary-card{
  background:var(--panel); border:2px solid var(--border); border-radius:20px;
  padding:32px 30px; max-width:460px; backdrop-filter:blur(10px);
  box-shadow:0 14px 40px rgba(0,0,0,.25);
}
.summary-card .unlocked-tag{
  font-family:'Baloo 2',sans-serif; font-weight:700; font-size:13px; letter-spacing:.22em; color:var(--gold);
  margin-bottom:14px; text-shadow:0 0 10px rgba(255,217,61,.5);
}
.trait-list{list-style:none; display:flex; flex-direction:column; gap:10px; margin-top:14px;}
.trait-list li{
  display:flex; align-items:center; gap:10px; font-size:15px; color:var(--text);
  opacity:0; transform:translateX(-10px); animation:traitIn .5s ease forwards;
}
.trait-list li::before{content:"✦"; color:var(--gold);}
@keyframes traitIn{to{opacity:1; transform:translateX(0);}}


/* ===== VALUES QUEST (Chapter 1 - Quest 3) ===== */
.values-intro{
  color:var(--dim); font-size:14px; line-height:1.75; max-width:520px; margin:0 auto 24px;
}
.value-orbit-field{
  display:flex; gap:42px; flex-wrap:wrap; justify-content:center; margin:18px 0 12px;
}
.value-planet{
  width:132px; text-align:center; cursor:pointer; position:relative;
  transition:transform .35s cubic-bezier(.34,1.56,.64,1);
}
.value-planet:hover{transform:translateY(-7px);}
.value-planet.active{transform:translateY(-9px) scale(1.08);}
.value-ball{
  width:100px; height:100px; border-radius:50%; margin:0 auto 12px;
  display:flex; align-items:center; justify-content:center; font-size:34px;
  position:relative; transition:transform .35s ease, box-shadow .35s ease;
}
.value-planet:hover .value-ball{transform:scale(1.08);}
.value-planet.active .value-ball{transform:scale(1.14);}
.value-ball.challenge{
  background:radial-gradient(circle at 35% 28%, #FFD2B8, var(--coral) 58%, #8E321A 100%);
  box-shadow:0 0 36px rgba(255,122,69,.48);
}
.value-ball.commitment{
  background:radial-gradient(circle at 35% 28%, #D7FFE7, var(--green) 58%, #177A48 100%);
  box-shadow:0 0 36px rgba(74,222,128,.42);
}
.value-ball.integrity{
  background:radial-gradient(circle at 35% 28%, #FFFBE0, var(--gold) 58%, #B57A00 100%);
  box-shadow:0 0 36px rgba(255,217,61,.5);
}
.value-planet.active .value-ball.challenge{
  box-shadow:0 0 68px rgba(255,122,69,.82);
}
.value-planet.active .value-ball.commitment{
  box-shadow:0 0 68px rgba(74,222,128,.72);
}
.value-planet.active .value-ball.integrity{
  box-shadow:0 0 68px rgba(255,217,61,.82);
}
.value-name{
  font-family:'Baloo 2',sans-serif; font-weight:700; font-size:14px; letter-spacing:.08em;
}
.value-planet[data-value="challenge"] .value-name{color:var(--coral);}
.value-planet[data-value="commitment"] .value-name{color:var(--green);}
.value-planet[data-value="integrity"] .value-name{color:var(--gold);}
.value-unlocked{
  font-family:'Baloo 2',sans-serif; font-size:10px; letter-spacing:.12em;
  color:var(--dim); margin-top:5px; opacity:.7;
}
.value-progress{
  display:flex; align-items:center; justify-content:center; gap:8px;
  margin:18px 0 20px; color:var(--dim); font-size:11px;
  font-family:'Baloo 2',sans-serif; letter-spacing:.08em;
}
.value-progress .vp-dot{
  width:8px; height:8px; border-radius:50%; background:rgba(255,255,255,.22);
  transition:all .3s ease;
}
.value-progress .vp-dot.done{
  background:var(--green); box-shadow:0 0 8px var(--green);
}
.value-progress .vp-label{margin-right:4px;}
.value-episode{
  width:100%; max-width:620px; margin:4px auto 0; text-align:left;
  background:linear-gradient(135deg, rgba(139,92,246,.18), rgba(255,93,162,.08));
  border:2px solid var(--border); border-radius:18px; padding:24px 26px;
  backdrop-filter:blur(10px); box-shadow:0 12px 34px rgba(0,0,0,.22);
  opacity:0; max-height:0; overflow:hidden; transform:translateY(10px);
  transition:opacity .45s ease, max-height .55s ease, transform .45s ease;
}
.value-episode.show{
  opacity:1; max-height:520px; transform:translateY(0);
}
.ve-badge{
  display:inline-block; font-family:'Baloo 2',sans-serif; font-weight:700; font-size:10.5px;
  letter-spacing:.12em; color:var(--gold); border:1.5px solid rgba(255,217,61,.45);
  padding:4px 10px; border-radius:12px; margin-bottom:11px;
}
.ve-title{
  font-family:'Baloo 2',sans-serif; font-weight:700; font-size:21px; margin-bottom:12px;
}
.ve-section-label{
  font-family:'Baloo 2',sans-serif; font-weight:700; font-size:10.5px;
  letter-spacing:.13em; color:var(--cyan); margin:14px 0 6px;
}
.ve-text{font-size:14px; line-height:1.75; color:var(--text);}
.ve-learned{
  padding:12px 14px; border-left:3px solid var(--gold);
  background:rgba(255,217,61,.06); color:var(--text); border-radius:0 10px 10px 0;
}
.all-values{
  display:none; margin-top:18px; color:var(--gold);
  font-family:'Baloo 2',sans-serif; font-weight:700; font-size:13px; letter-spacing:.12em;
}
.all-values.show{display:block; animation:fadeUp .5s ease both;}

/* ===== MISSIONS (Chapter 2) ===== */
.mission-row{display:flex; flex-direction:column; gap:0; width:100%; max-width:660px;}
.mission-card{
  background:var(--panel); border:2px solid var(--border); border-left:5px solid var(--cyan); border-radius:16px;
  padding:24px 26px; margin-bottom:16px; text-align:left; cursor:pointer;
  backdrop-filter:blur(8px);
  transition:border-color .3s ease, transform .2s ease, box-shadow .3s ease;
}
.mission-card[data-mission="2"]{border-left-color:var(--green);}
.mission-card[data-mission="3"]{border-left-color:var(--pink);}
.mission-card:hover{transform:translateY(-4px); box-shadow:0 10px 26px rgba(0,0,0,.25);}
.mission-card.opened{border-color:var(--gold);}
.mc-top{display:flex; justify-content:space-between; align-items:center; gap:14px;}
.mc-badge{
  font-family:'Baloo 2',sans-serif; font-weight:600; font-size:11px; letter-spacing:.12em; color:var(--gold);
  border:1.5px solid rgba(255,217,61,.45); padding:4px 11px; border-radius:12px;
}
.mc-check{width:24px; height:24px; border-radius:50%; border:2px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:13px; color:transparent; transition:all .3s cubic-bezier(.34,1.56,.64,1); flex:none;}
.mc-check.done{background:var(--gold); border-color:var(--gold); color:var(--deep); transform:scale(1.12); box-shadow:0 0 14px rgba(255,217,61,.6);}
.mc-title{font-family:'Baloo 2',sans-serif; font-size:18px; font-weight:700; margin:12px 0 6px;}
.mc-sub{font-size:13px; color:var(--dim); margin-bottom:0;}
.mc-detail{max-height:0; overflow:hidden; transition:max-height .5s cubic-bezier(.16,1,.3,1);}
.mission-card.opened .mc-detail{max-height:240px;}
.mc-detail-inner{padding-top:16px; border-top:1px dashed var(--border); margin-top:16px;}
.mc-detail-inner p{font-size:14.5px; color:var(--text); margin-bottom:12px;}
.skill-badges{display:flex; flex-wrap:wrap; gap:7px;}
.skill-badges span{
  font-size:11.5px; padding:5px 12px; border-radius:14px;
  background:rgba(79,216,238,.14); color:var(--cyan); border:1px solid rgba(79,216,238,.3);
}

.status-panel{
  margin-top:30px; width:100%; max-width:660px;
  background:var(--panel); border:2px solid var(--border); border-radius:18px; padding:26px;
  opacity:0; max-height:0; overflow:hidden; transition:opacity .5s ease, max-height .6s ease;
}
.status-panel.show{opacity:1; max-height:400px;}
.status-title{font-family:'Baloo 2',sans-serif; font-weight:700; font-size:14px; letter-spacing:.15em; color:var(--gold); margin-bottom:16px;}
.constellation{display:flex; flex-wrap:wrap; gap:9px; margin-top:6px;}
.constellation span{
  font-size:12.5px; padding:6px 14px; border-radius:14px;
  background:rgba(139,92,246,.18); color:#E7DEFF; border:1px solid rgba(139,92,246,.35);
  opacity:0; animation:fadeUp .5s ease forwards;
}

/* ===== CHAPTER 3 ===== */
.future-stack{display:flex; flex-direction:column; gap:22px; width:100%; max-width:620px;}
.future-card{
  background:linear-gradient(135deg, rgba(139,92,246,.18), rgba(255,93,162,.1));
  border:2px solid var(--border); border-radius:20px; padding:28px; text-align:left;
  position:relative; overflow:hidden;
}
.future-card .fc-num{
  position:absolute; top:-14px; right:6px; font-family:'Baloo 2',sans-serif;
  font-size:76px; font-weight:800; color:rgba(255,255,255,.06);
}
.future-card .fc-eyebrow{font-family:'Baloo 2',sans-serif; font-weight:700; font-size:11.5px; letter-spacing:.18em; color:var(--pink); margin-bottom:8px;}
.future-card h3{font-family:'Baloo 2',sans-serif; font-size:20px; font-weight:700; margin-bottom:10px;}
.future-card p{font-size:14.5px; color:var(--dim); margin-bottom:14px;}
.flow-path{display:flex; align-items:center; flex-wrap:wrap; gap:6px; font-size:12px; font-family:'Baloo 2',sans-serif; font-weight:600; color:var(--cyan);}
.flow-path .arrow{color:var(--dim);}
.flow-path span.step{background:rgba(79,216,238,.12); padding:5px 11px; border-radius:10px; border:1px solid rgba(79,216,238,.25);}

/* ===== FINAL ===== */
.final-galaxy{
  width:180px; height:180px; border-radius:50%; margin:0 auto 34px;
