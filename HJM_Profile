  keys.forEach((key, i)=>{
    const dot = document.getElementById('vp'+(i+1));
    const status = document.getElementById('valueStatus'+key.charAt(0).toUpperCase()+key.slice(1));
    if(valueClicked.has(key)){
      dot.classList.add('done');
      status.textContent = 'UNLOCKED';
    }
  });

  if(valueClicked.size===3){
    document.getElementById('allValues').classList.add('show');
    document.getElementById('btnToQuest4').style.display='inline-block';
  }
}

document.querySelectorAll('.value-planet').forEach(p=>{
  p.addEventListener('click', ()=>openValue(p.dataset.value));
});

document.getElementById('btnToQuest4').addEventListener('click', ()=>goQuest1(3));
document.getElementById('btnBeginProfessional').addEventListener('click', ()=>showScreen('ch2'));

/* ---- CHAPTER 2 ---- */
let ch2Done = [false,false,false];
document.querySelectorAll('.mission-card').forEach((card, idx)=>{
  card.addEventListener('click', ()=>{
    card.classList.toggle('opened');
    if(card.classList.contains('opened') && !ch2Done[idx]){
      ch2Done[idx] = true;
      document.getElementById('check'+(idx+1)).classList.add('done');
      checkMissionsComplete();
    }
    updateHud('ch2');
  });
});
const skillPool = ['Investment','Strategy','Portfolio Management','Global Business','Digital Assets','Communication'];
function checkMissionsComplete(){
  if(ch2Done.every(Boolean)){
    const panel = document.getElementById('statusPanel');
    panel.classList.add('show');
    const cons = document.getElementById('constellation');
    cons.innerHTML = '';
    skillPool.forEach((s,i)=>{
      const el = document.createElement('span');
      el.textContent = s;
      el.style.animationDelay = (i*0.08)+'s';
      cons.appendChild(el);
    });
    setTimeout(()=>panel.scrollIntoView({behavior:'smooth', block:'nearest'}), 300);
  }
}
document.getElementById('btnToCh3').addEventListener('click', ()=>showScreen('ch3'));

/* ---- CHAPTER 3 ---- */
document.getElementById('btnToFinal').addEventListener('click', ()=>{
  document.getElementById('explorerSignature').textContent = ' CLIMB UP THE LADDER';
  showScreen('final');
});

/* ---- FINAL ---- */
document.getElementById('btnReplay').addEventListener('click', ()=>{
  ch1Quest = 0; offdutyClicked = new Set(); ch2Done=[false,false,false]; valueClicked = new Set();
  document.querySelectorAll('.mini-planet').forEach(p=>p.classList.remove('done'));
  document.querySelectorAll('.value-planet').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.vp-dot').forEach(d=>d.classList.remove('done'));
  document.querySelectorAll('.value-unlocked').forEach(s=>s.textContent='LOCKED');
  document.getElementById('valueEpisode').classList.remove('show');
  document.getElementById('allValues').classList.remove('show');
  document.getElementById('btnToQuest4').style.display='none';
  document.getElementById('offdutyCaption').textContent = '행성을 클릭해서 저의 Universe를 탐험해보세요.';
  document.getElementById('btnToQuest3').style.display='none';
  document.getElementById('btnDiscoverPersonality').style.display='inline-block';
  document.getElementById('meterWrap').classList.remove('show');
  document.getElementById('meterFill').classList.remove('go');
  document.getElementById('meterDot').classList.remove('go');
  document.getElementById('personalityLine').innerHTML='';
  document.querySelectorAll('.mission-card').forEach(c=>c.classList.remove('opened'));
  document.querySelectorAll('.mc-check').forEach(c=>c.classList.remove('done'));
  document.getElementById('statusPanel').classList.remove('show');
  goQuest1(0);
  showScreen('intro');
});
document.getElementById('btnMissionsAgain').addEventListener('click', ()=>showScreen('ch2'));

updateHud('intro');
</script>
